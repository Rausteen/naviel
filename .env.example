# ──────────────────────────────────────────────────────────────────────────
# Méthode C — suivi de conversion hors-ligne Cal.com → Google Ads
# Copier en `.env` (jamais commité) et renseigner côté serveur (Dokploy/host).
# Le webhook tourne dans server.mjs (prod). Endpoint : POST /api/cal/webhook
# ──────────────────────────────────────────────────────────────────────────

# Secret du webhook Cal.com (Cal.com → Settings → Webhooks → "Secret").
# Sert à vérifier la signature X-Cal-Signature-256.
CAL_WEBHOOK_SECRET=

# Google Ads API (compte développeur + OAuth2)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID du compte Google Ads cible (chiffres, sans tirets)
GOOGLE_ADS_CUSTOMER_ID=
# ID du compte administrateur (MCC), si le compte est géré (sinon laisser vide)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# ID numérique de l'action de conversion (Conversions → l'action → ID dans l'URL)
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Optionnel
GOOGLE_ADS_CONVERSION_VALUE=     # ex. "150" (valeur d'un RDV) — laisser vide pour aucune valeur
GOOGLE_ADS_CURRENCY=EUR
GOOGLE_ADS_API_VERSION=v18       # mettre à jour si Google fait évoluer l'API

# Conseil : régler le fuseau du serveur pour des horodatages corrects
# TZ=Europe/Paris
