---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Button from "@components/Button.astro";
import { site } from "@config";
---

<Layout title="Page introuvable" description="Cette page n'existe pas." noindex>
  <section class="relative flex min-h-[70vh] items-center overflow-hidden py-28">
    <div class="ambient-halo"></div>
    <Container class="relative text-center">
      <p class="font-display text-7xl font-semibold tracking-tight text-accent sm:text-8xl">
        404
      </p>
      <h1 class="mt-6 text-3xl font-semibold sm:text-4xl">
        Cette page a pris la sortie.
      </h1>
      <p class="mx-auto mt-4 max-w-md text-ink-soft">
        Le lien est peut-être cassé, ou la page a été déplacée. Revenons sur la
        bonne voie.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href="/" variant="primary" size="lg">Retour à l'accueil</Button>
        <Button href="/realisations" variant="ghost" size="lg">
          Voir nos réalisations
        </Button>
      </div>
      <p class="mt-8 text-sm text-muted">
        Besoin d'aide ?
        <a
          href={`mailto:${site.contact.email}`}
          class="text-ink-soft underline decoration-accent/40 underline-offset-4 transition-colors hover:text-ink"
        >
          {site.contact.email}
        </a>
      </p>
    </Container>
  </section>
</Layout>
