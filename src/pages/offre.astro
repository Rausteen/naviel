---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Kicker from "@components/Kicker.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import Reveal from "@components/Reveal.astro";
import CTASection from "@components/CTASection.astro";
import { site } from "@config";

const inclus = [
  {
    num: "01",
    title: "Conception sur-mesure",
    text: "Un site unique, conçu pour votre activité. UI/UX orientée conversion, mobile-first, aucune base de template.",
    points: [
      "Design original aligné sur votre positionnement",
      "Parcours pensé pour la prise de rendez-vous",
      "Mise en avant des réalisations et de la preuve",
      "Optimisé mobile, rapide et accessible",
    ],
  },
  {
    num: "02",
    title: "Mise en ligne clé en main",
    text: "On s'occupe de toute la partie technique pour que vous n'ayez rien à gérer.",
    points: [
      "Nom de domaine (à votre nom)",
      "Hébergement rapide et sécurisé",
      "Certificat SSL (HTTPS)",
      "Adresses e-mail professionnelles",
    ],
  },
  {
    num: "03",
    title: "Référencement SEO local",
    text: "Être trouvé par les bonnes personnes, là où elles cherchent vos prestations.",
    points: [
      "Optimisation technique (vitesse, balisage, structure)",
      "Ciblage des requêtes locales de votre métier",
      "Configuration de la fiche Google Business",
      "Contenus pensés pour le référencement",
    ],
  },
];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Offre",
      item: `${site.siteUrl}/offre`,
    },
  ],
};

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Création de site web et acquisition de clients",
  provider: { "@type": "Organization", name: site.brandName },
  areaServed: { "@type": "Country", name: "France" },
  description:
    "Conception de site sur-mesure, mise en ligne clé en main (hébergement + nom de domaine), référencement SEO local, avec Google Ads en option.",
  url: `${site.siteUrl}/offre`,
};
---

<Layout
  title="Offre"
  description="Notre offre : conception de site sur-mesure, mise en ligne clé en main (hébergement + nom de domaine), référencement SEO local, et Google Ads en option. Agence basée à Paris, partout en France."
  jsonLd={[breadcrumb, serviceLd]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <Reveal class="max-w-3xl">
      <Kicker>Offre</Kicker>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl lg:text-6xl">
        Un site, sa visibilité, et des clients à la clé.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft">
        Une offre complète, sans pièces détachées : on conçoit votre site, on le
        met en ligne et on le rend visible sur Google. La publicité vient en
        accélérateur, quand vous le décidez.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={site.contact.calendlyUrl} variant="primary" size="lg" external>
          Réserver un appel de 15 min
        </Button>
        <Button href="/realisations" variant="ghost" size="lg">
          Voir nos réalisations
        </Button>
      </div>
    </Reveal>
  </Section>

  <!-- Ce qui est inclus -->
  <Section spacing="sm">
    <div class="grid gap-5 lg:grid-cols-3">
      {
        inclus.map((item, i) => (
          <Reveal delay={i * 90}>
            <Card class="flex h-full flex-col">
              <span class="font-display text-sm font-semibold text-accent">
                {item.num}
              </span>
              <h2 class="mt-4 text-2xl font-semibold">{item.title}</h2>
              <p class="mt-3 text-ink-soft">{item.text}</p>
              <ul class="mt-6 space-y-3 text-sm text-ink-soft">
                {item.points.map((p) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M3 8.5l3 3 7-7"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </Card>
          </Reveal>
        ))
      }
    </div>
  </Section>

  <!-- Google Ads — option mise en valeur -->
  <Section spacing="md">
    <Reveal>
      <Card accent class="overflow-hidden">
        <div class="ambient-halo opacity-50"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-center">
          <div>
            <span
              class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-accent/40 bg-accent/10 px-3 py-1 text-xs font-medium uppercase tracking-wider text-accent"
            >
              Option · Accélérateur
            </span>
            <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
              Google Ads : des appels qualifiés dès maintenant.
            </h2>
            <p class="mt-4 max-w-xl text-ink-soft">
              Le SEO construit votre visibilité dans la durée. La publicité, elle,
              génère des demandes immédiatement. Quand vous voulez accélérer, on
              lance et on pilote vos campagnes.
            </p>
            <ul class="mt-6 grid gap-3 text-sm text-ink-soft sm:grid-cols-2">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                Piloté par un media buyer
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                Suivi sur le ROI, pas sur les clics
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                Optimisation continue des campagnes
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                Budget pub payé directement à Google
              </li>
            </ul>
            <p class="mt-5 text-sm text-muted">
              Vous payez le budget pub directement à Google. Nous, on gère la
              performance.
            </p>
          </div>
          <div class="flex lg:justify-end">
            <Button href={site.contact.calendlyUrl} variant="primary" size="lg" external>
              En parler
            </Button>
          </div>
        </div>
      </Card>
    </Reveal>
  </Section>

  <!-- Comment on travaille le prix -->
  <Section spacing="sm" class="border-t border-line bg-bg-2">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <Reveal>
        <Kicker>Tarifs</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          Sur devis, clair et ferme.
        </h2>
      </Reveal>
      <Reveal delay={100} class="space-y-5 text-ink-soft">
        <p>
          Chaque projet est différent : le périmètre dépend du nombre de pages,
          des contenus à produire et des options choisies. On établit un devis
          précis après l'appel découverte — un prix clair et ferme, sans
          surprise en cours de route.
        </p>
        <p>
          Pas d'abonnement opaque ni de coûts cachés : vous savez exactement ce
          que vous payez, et le site vous appartient.
        </p>
      </Reveal>
    </div>
  </Section>

  <CTASection />
</Layout>
