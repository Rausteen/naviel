---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Kicker from "@components/Kicker.astro";
import Button from "@components/Button.astro";
import Reveal from "@components/Reveal.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import CTASection from "@components/CTASection.astro";
import Faq from "@components/Faq.astro";
import { site } from "@config";

export async function getStaticPaths() {
  const sectors = await getCollection("sectors");
  return sectors.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"sectors">;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

const pageUrl = `${site.siteUrl}/secteurs/${entry.slug}`;

// Preuve : on ne montre les réalisations que pour les secteurs qui en ont (auto)
const proofCases = data.hasProof
  ? (await getCollection("caseStudies"))
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 2)
  : [];

// Pages métiers rattachées à ce secteur (maillage interne)
const verticales = (await getCollection("verticales"))
  .filter((v) => v.data.sectorSlug === entry.slug)
  .sort((a, b) => a.data.order - b.data.order);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    { "@type": "ListItem", position: 2, name: "Secteurs", item: `${site.siteUrl}/secteurs` },
    { "@type": "ListItem", position: 3, name: data.name, item: pageUrl },
  ],
};

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: `Acquisition de clients — ${data.name}`,
  provider: { "@type": "Organization", name: site.brandName },
  areaServed: { "@type": "Country", name: site.areaServed },
  description: data.summary,
  url: pageUrl,
};

// Mini-FAQ d'objections (commune aux secteurs) — bon pour la conversion + le SEO
const faq = [
  {
    q: "Combien de temps pour être en ligne ?",
    a: "Selon le périmètre, un site vitrine sur-mesure se livre en quelques semaines. On vous donne un calendrier précis dès l'appel découverte.",
  },
  {
    q: "Combien ça coûte ?",
    a: "La création d'un site démarre à 2 499 € (payable en plusieurs fois), avec un suivi mensuel à partir de 99 €/mois (hébergement, maintenance, SEO). La gestion Google Ads est une option. Devis clair et ferme avant de démarrer.",
  },
  {
    q: "Vous travaillez à distance ?",
    a: `Oui. ${site.brandName} est basée à ${site.city} et accompagne ses clients partout en France, à distance — du premier appel jusqu'aux résultats.`,
  },
  {
    q: "À qui appartient le site ?",
    a: "À vous. Le nom de domaine est à votre nom, et vous n'êtes jamais pris en otage.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={data.seoTitle ?? data.name}
  description={data.seoDescription ?? data.summary}
  jsonLd={[breadcrumb, serviceLd, faqLd]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <nav aria-label="Fil d'Ariane" class="text-sm text-muted">
      <a href="/" class="transition-colors hover:text-ink-soft">Accueil</a>
      <span aria-hidden="true"> / </span>
      <a href="/secteurs" class="transition-colors hover:text-ink-soft">Secteurs</a>
      <span aria-hidden="true"> / </span>
      <span class="text-ink-soft">{data.name}</span>
    </nav>

    <div class="mt-8 max-w-3xl">
      {data.eyebrow && <Kicker>{data.eyebrow}</Kicker>}
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl lg:text-6xl">
        {data.title}
      </h1>
      <p class="mt-6 text-lg text-ink-soft">{data.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button booking variant="primary" size="lg" >
          Réserver un appel de 15 min
        </Button>
        {
          data.hasProof && (
            <Button href="/realisations" variant="ghost" size="lg">
              Voir nos réalisations
            </Button>
          )
        }
      </div>
    </div>
  </Section>

  <!-- Corps de la landing (intro, ce qu'on fait) -->
  <Section spacing="sm">
    <article class="prose-naviel max-w-3xl">
      <Content />
    </article>
  </Section>

  <!-- Réassurance -->
  <Section spacing="sm">
    <ul
      class="grid grid-cols-1 overflow-hidden rounded-[var(--radius-card)] border border-line bg-[linear-gradient(180deg,var(--color-surface),var(--color-bg-2))] sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        site.signals.map((s, i) => (
          <li
            class:list={[
              "flex items-start gap-3 border-line p-6",
              i % 2 === 0 && "border-r",
              i < site.signals.length - 1 && "lg:border-r",
              i < 2 && "border-b lg:border-b-0",
            ]}
          >
            <span
              class="mt-1 inline-block size-2 shrink-0 rotate-45 rounded-[2px] bg-accent shadow-[0_0_10px_-2px_rgba(200,242,78,0.7)]"
              aria-hidden="true"
            />
            <span class="text-sm leading-snug text-ink-soft">{s}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Preuve : réalisations (uniquement si le secteur en a) -->
  {
    proofCases.length > 0 && (
      <Section spacing="sm" class="border-t border-line bg-bg-2">
        <Reveal class="max-w-2xl">
          <Kicker>La preuve</Kicker>
          <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
            Des sites en production dans ce secteur.
          </h2>
        </Reveal>
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {proofCases.map((cs, i) => (
            <Reveal delay={i * 90}>
              <CaseStudyCard
                href={`/realisations/${cs.slug}`}
                title={cs.data.title}
                client={cs.data.client}
                secteur={cs.data.secteur}
                summary={cs.data.summary}
                cover={cs.data.cover}
                url={cs.data.url}
                year={cs.data.year}
                clientCity={cs.data.clientCity}
                services={cs.data.services}
              />
            </Reveal>
          ))}
        </div>
      </Section>
    )
  }

  <!-- Pages métiers (maillage interne) -->
  {
    verticales.length > 0 && (
      <Section spacing="sm">
        <Reveal class="max-w-2xl">
          <Kicker dot={false}>Votre métier précisément</Kicker>
          <h2 class="mt-4 text-2xl font-semibold sm:text-3xl">
            Des pages dédiées à votre activité.
          </h2>
        </Reveal>
        <div class="mt-8 flex flex-wrap gap-3">
          {verticales.map((v) => (
            <a
              href={`/creation-site/${v.slug}`}
              class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-line bg-surface px-4 py-2.5 text-sm text-ink-soft transition-colors hover:border-line-2 hover:text-ink"
            >
              <span class="size-1.5 rotate-45 rounded-[1px] bg-accent" aria-hidden="true" />
              {v.data.metier}
            </a>
          ))}
        </div>
      </Section>
    )
  }

  <!-- Mini-FAQ d'objections -->
  <Section spacing="sm">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <Reveal>
        <Kicker>FAQ</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          Les questions fréquentes.
        </h2>
      </Reveal>
      <Reveal delay={100}>
        <Faq items={faq} />
      </Reveal>
    </div>
  </Section>

  <CTASection
    title={`Prêt à attirer plus de clients dans votre secteur ?`}
    text="Un appel de 15 minutes, sans engagement. On regarde votre situation et ce qu'on peut faire pour vous amener plus de rendez-vous."
  />
</Layout>

<style is:global>
  .prose-naviel {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-naviel > * + * {
    margin-top: 1.25rem;
  }
  .prose-naviel h2 {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-top: 2.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-naviel a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-naviel strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-naviel ul {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-naviel li + li {
    margin-top: 0.5rem;
  }
  .prose-naviel li::marker {
    color: var(--color-accent);
  }
  .prose-naviel blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-ink-soft);
  }
</style>
