---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Kicker from "@components/Kicker.astro";
import Reveal from "@components/Reveal.astro";
import SectorCard from "@components/SectorCard.astro";
import CTASection from "@components/CTASection.astro";
import { site } from "@config";

// Vitrine phare en premier, puis les autres
const sectors = [...site.sectors].sort(
  (a, b) => Number(b.featured) - Number(a.featured),
);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Secteurs",
      item: `${site.siteUrl}/secteurs`,
    },
  ],
};
---

<Layout
  title="Secteurs"
  description="Les secteurs que Naviel accompagne, agence basée à Paris : automobile premium (vitrine phare), habitat & rénovation, beauté & esthétique, santé, artisanat & commerce premium, immobilier."
  jsonLd={[breadcrumb]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <Reveal class="max-w-3xl">
      <Kicker>Secteurs</Kicker>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl lg:text-6xl">
        Une méthode premium, déclinée par secteur.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft">
        On se spécialise par métier pour mieux comprendre votre marché, vos
        clients et vos mots-clés. L'automobile premium est notre vitrine phare —
        c'est là qu'on a fait nos preuves — et on applique la même méthode aux
        autres secteurs premium.
      </p>
    </Reveal>
  </Section>

  <Section spacing="sm">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sectors.map((sector, i) => (
          <Reveal delay={i * 70}>
            <SectorCard sector={sector} />
          </Reveal>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      Votre secteur n'est pas listé ? Si vous êtes une entreprise de service
      premium, parlons-en : la méthode reste la même.
    </p>
  </Section>

  <CTASection />
</Layout>
