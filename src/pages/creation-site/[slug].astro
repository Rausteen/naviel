---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Kicker from "@components/Kicker.astro";
import Button from "@components/Button.astro";
import Reveal from "@components/Reveal.astro";
import Faq from "@components/Faq.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import CTASection from "@components/CTASection.astro";
import { site } from "@config";

export async function getStaticPaths() {
  const items = await getCollection("verticales");
  return items.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"verticales">;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

const pageUrl = `${site.siteUrl}/creation-site/${entry.slug}`;

// Secteur parent (pour le maillage interne)
const sectors = await getCollection("sectors");
const parent = sectors.find((s) => s.slug === data.sectorSlug);

// Preuve auto premium : on montre les réalisations si le parent en a
const proofCases =
  parent?.data.hasProof
    ? (await getCollection("caseStudies"))
        .sort((a, b) => a.data.order - b.data.order)
        .slice(0, 2)
    : [];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Création de site",
      item: `${site.siteUrl}/creation-site`,
    },
    { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
  ],
};

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: data.seoTitle,
  provider: { "@type": "Organization", name: site.brandName },
  areaServed: { "@type": "Country", name: site.areaServed },
  description: data.seoDescription,
  url: pageUrl,
};

const faq = [
  {
    q: "Combien de temps pour être en ligne ?",
    a: "Selon le périmètre, un site vitrine sur-mesure se livre en quelques semaines. Calendrier précis dès l'appel découverte.",
  },
  {
    q: "Combien ça coûte ?",
    a: "La création démarre à 2 500 € (payable en plusieurs fois), avec un suivi mensuel à partir de 99 €/mois. Devis clair et ferme avant de démarrer.",
  },
  {
    q: "Vous travaillez à distance ?",
    a: `Oui. ${site.brandName} est basée à ${site.city} et accompagne ses clients à distance, du premier appel jusqu'aux résultats.`,
  },
  {
    q: "À qui appartient le site ?",
    a: "À vous. Le nom de domaine est à votre nom, et vous n'êtes jamais pris en otage.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={data.seoTitle}
  description={data.seoDescription}
  jsonLd={[breadcrumb, serviceLd, faqLd]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <nav aria-label="Fil d'Ariane" class="text-sm text-muted">
      <a href="/" class="transition-colors hover:text-ink-soft">Accueil</a>
      <span aria-hidden="true"> / </span>
      <a href="/secteurs" class="transition-colors hover:text-ink-soft">Secteurs</a>
      <span aria-hidden="true"> / </span>
      <span class="text-ink-soft">{data.metier}</span>
    </nav>

    <div class="mt-8 max-w-3xl">
      {data.eyebrow && <Kicker>{data.eyebrow}</Kicker>}
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl lg:text-6xl">
        {data.title}
      </h1>
      <p class="mt-6 text-lg text-ink-soft">{data.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={site.contact.bookingUrl} variant="primary" size="lg" external arrow>
          Réserver un appel de 15 min
        </Button>
        {
          proofCases.length > 0 && (
            <Button href="/realisations" variant="ghost" size="lg">
              Voir nos réalisations
            </Button>
          )
        }
      </div>
    </div>
  </Section>

  <!-- Corps -->
  <Section spacing="sm">
    <article class="prose-naviel max-w-3xl">
      <Content />
    </article>
  </Section>

  <!-- Réassurance -->
  <Section spacing="sm">
    <ul
      class="grid grid-cols-1 overflow-hidden rounded-[var(--radius-card)] border border-line bg-[linear-gradient(180deg,var(--color-surface),var(--color-bg-2))] sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        site.signals.map((s, i) => (
          <li
            class:list={[
              "flex items-start gap-3 border-line p-6",
              i % 2 === 0 && "border-r",
              i < site.signals.length - 1 && "lg:border-r",
              i < 2 && "border-b lg:border-b-0",
            ]}
          >
            <span
              class="mt-1 inline-block size-2 shrink-0 rotate-45 rounded-[2px] bg-accent shadow-[0_0_10px_-2px_rgba(200,242,78,0.7)]"
              aria-hidden="true"
            />
            <span class="text-sm leading-snug text-ink-soft">{s}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Preuve (auto premium) -->
  {
    proofCases.length > 0 && (
      <Section spacing="sm" class="border-t border-line bg-bg-2">
        <Reveal class="max-w-2xl">
          <Kicker>La preuve</Kicker>
          <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
            Des sites en production dans ce secteur.
          </h2>
        </Reveal>
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {proofCases.map((cs, i) => (
            <Reveal delay={i * 90}>
              <CaseStudyCard
                href={`/realisations/${cs.slug}`}
                title={cs.data.title}
                client={cs.data.client}
                secteur={cs.data.secteur}
                summary={cs.data.summary}
                cover={cs.data.cover}
                url={cs.data.url}
                year={cs.data.year}
                clientCity={cs.data.clientCity}
                services={cs.data.services}
              />
            </Reveal>
          ))}
        </div>
      </Section>
    )
  }

  <!-- FAQ -->
  <Section spacing="sm">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <Reveal>
        <Kicker>FAQ</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          Les questions fréquentes.
        </h2>
        {
          parent && (
            <p class="mt-4 text-ink-soft">
              Voir aussi notre page{" "}
              <a
                href={`/secteurs/${parent.slug}`}
                class="text-accent underline underline-offset-2"
              >
                {parent.data.name}
              </a>
              .
            </p>
          )
        }
      </Reveal>
      <Reveal delay={100}>
        <Faq items={faq} />
      </Reveal>
    </div>
  </Section>

  <CTASection
    title={`Prêt à attirer plus de clients ?`}
    text="Un appel de 15 minutes, sans engagement. On regarde votre situation et ce qu'on peut faire pour vous amener plus de rendez-vous."
  />
</Layout>

<style is:global>
  .prose-naviel {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-naviel > * + * {
    margin-top: 1.25rem;
  }
  .prose-naviel h2 {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-top: 2.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-naviel a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-naviel strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-naviel ul {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-naviel li + li {
    margin-top: 0.5rem;
  }
  .prose-naviel li::marker {
    color: var(--color-accent);
  }
  .prose-naviel blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
  }
</style>
