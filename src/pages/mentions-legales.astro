---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import { site } from "@config";
---

<Layout
  title="Mentions légales"
  description="Mentions légales du site Naviel."
  noindex
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <div class="prose-legal mx-auto max-w-3xl">
      <h1>Mentions légales</h1>

      <h2>Éditeur du site</h2>
      <ul>
        <li>Dénomination : {site.brandName} — [forme juridique]</li>
        <li>Siège social : [adresse], {site.city}, France</li>
        <li>SIREN / SIRET : [numéro]</li>
        <li>Numéro de TVA intracommunautaire : [numéro]</li>
        <li>
          Directeur de la publication :{" "}
          {site.founder.name ? site.founder.name : "[nom]"}
        </li>
        <li>
          E-mail : <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
      </ul>

      <h2>Hébergement</h2>
      <ul>
        <li>Hébergeur : [nom de l'hébergeur]</li>
        <li>Adresse : [adresse de l'hébergeur]</li>
        <li>Contact : [contact de l'hébergeur]</li>
      </ul>

      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus présents sur ce site (textes, images, logo,
        charte graphique) est protégé par le droit de la propriété
        intellectuelle. Toute reproduction, sans autorisation écrite préalable,
        est interdite.
      </p>

      <h2>Responsabilité</h2>
      <p>
        {site.brandName} s'efforce d'assurer l'exactitude des informations
        diffusées sur ce site, sans toutefois garantir leur exhaustivité ni leur
        parfaite mise à jour.
      </p>

      <h2>Contact</h2>
      <p>
        Pour toute question relative à ces mentions légales, écrivez-nous à
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      </p>
    </div>
  </Section>
</Layout>

<style is:global>
  .prose-legal {
    color: var(--color-ink-soft);
    line-height: 1.75;
  }
  .prose-legal h1 {
    color: var(--color-ink);
    font-size: 2.5rem;
  }
  .prose-legal .lead {
    margin-top: 1rem;
    color: var(--color-muted);
  }
  .prose-legal h2 {
    color: var(--color-ink);
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-legal p {
    margin-top: 1rem;
  }
  .prose-legal ul {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-legal li + li {
    margin-top: 0.4rem;
  }
  .prose-legal li::marker {
    color: var(--color-accent);
  }
  .prose-legal a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-legal strong {
    color: var(--color-ink);
  }
</style>
