---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import strascleanCover from "../assets/case-studies/strasclean.png";
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Container from "@components/Container.astro";
import Kicker from "@components/Kicker.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import Reveal from "@components/Reveal.astro";
import Marquee from "@components/Marquee.astro";
import StatGrid from "@components/StatGrid.astro";
import CaseStudyCard from "@components/CaseStudyCard.astro";
import SectorCard from "@components/SectorCard.astro";
import MethodCard from "@components/MethodCard.astro";
import Testimonials from "@components/Testimonials.astro";
import Faq from "@components/Faq.astro";
import CTASection from "@components/CTASection.astro";
import { site } from "@config";

// Teaser réalisations — 100 % focus auto premium (jamais les produits maison)
const allCases = await getCollection("caseStudies");
const teaserCases = allCases
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const piliers = [
  {
    num: "01",
    step: "Le socle",
    title: "Conception sur-mesure",
    text: "UI/UX orientée conversion, mobile-first, zéro template. Un site qui reflète votre niveau et pousse au passage à l'action.",
    tag: "Design · UX · Performance",
  },
  {
    num: "02",
    step: "La mise en ligne",
    title: "Mise en ligne clé en main",
    text: "Nom de domaine, hébergement rapide et sécurisé, certificat SSL, e-mails professionnels. Vous n'avez rien à gérer.",
    tag: "Domaine · Hébergement · SSL",
  },
  {
    num: "03",
    step: "La visibilité",
    title: "Référencement SEO local",
    text: "Mots-clés de votre métier, fiche Google, optimisations techniques et contenus. On vous rend visible là où vos clients cherchent.",
    tag: "Recherche locale · Technique",
  },
];

const pourquoi = [
  {
    title: "Spécialistes de votre secteur",
    text: "On se spécialise par secteur — auto premium, habitat, esthétique… On apprend votre marché, vos clients et vos mots-clés.",
  },
  {
    title: "Un seul interlocuteur",
    text: "Design, mise en ligne, SEO, pub : un seul contact, pas de ping-pong entre prestataires.",
  },
  {
    title: "Orientés résultats, pas « joli »",
    text: "Un beau site qui ne convertit pas ne sert à rien. On mesure ce qui compte : les rendez-vous.",
  },
  {
    title: "On s'applique nos méthodes",
    text: "Ce site est notre propre vitrine. La qualité que vous voyez ici, c'est celle qu'on vous livre.",
  },
];

const process = [
  {
    num: "01",
    title: "Appel découverte",
    text: "15 minutes, sans engagement. On comprend votre activité, vos objectifs et votre marché.",
  },
  {
    num: "02",
    title: "Conception & validation",
    text: "On conçoit le site sur-mesure, vous validez. Itérations jusqu'à ce que ce soit parfait.",
  },
  {
    num: "03",
    title: "Mise en ligne & SEO",
    text: "Domaine, hébergement, SSL, e-mails. Référencement local activé dès le lancement.",
  },
  {
    num: "04",
    title: "On amène les clients",
    text: "SEO en continu, Google Ads en option, et suivi des résultats. On reste à vos côtés.",
  },
];

const faq = [
  {
    q: "Combien de temps pour avoir mon site en ligne ?",
    a: "Cela dépend du périmètre, mais un site vitrine sur-mesure se livre généralement en quelques semaines. On vous donne un calendrier précis dès l'appel découverte.",
  },
  {
    q: "Combien ça coûte ?",
    a: "La création d'un site démarre à 2 500 € (payable en 3 ou 4 fois), avec un suivi mensuel à partir de 99 €/mois (hébergement, maintenance, SEO). La gestion Google Ads est une option (à partir de 400 €/mois, hors budget pub). On vous donne un devis clair et ferme avant de démarrer.",
  },
  {
    q: "Qui gère le budget de publicité Google Ads ?",
    a: "Vous payez le budget publicitaire directement à Google, sur votre propre compte. Nous, on gère la performance : ciblage, annonces, optimisation et suivi du ROI. C'est transparent et vous gardez la main sur votre budget.",
  },
  {
    q: "Et si je n'ai pas de logo ni de photos ?",
    a: "Ce n'est pas bloquant. On vous accompagne sur l'identité visuelle et on peut vous orienter pour des photos de qualité. L'objectif est que le rendu soit à la hauteur de votre savoir-faire.",
  },
  {
    q: "À qui appartient le site une fois livré ?",
    a: "Le site vous appartient. Le nom de domaine est à votre nom, et vous n'êtes pas pris en otage. On travaille en confiance, pas par dépendance.",
  },
  {
    q: "Vous travaillez avec quels secteurs, et où ?",
    a: "On est basés à Paris et on accompagne les entreprises de service premium partout en France : auto premium (notre vitrine phare), habitat & rénovation, beauté & esthétique, santé, artisanat & commerce premium. Si vous êtes une entreprise premium, parlons-en lors de l'appel.",
  },
];

// JSON-LD : FAQPage (riches résultats Google)
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title={undefined}
  description={site.description}
  jsonLd={[faqJsonLd]}
>
  <!-- ============================ HERO ============================ -->
  <section class="relative overflow-hidden pt-24 sm:pt-32 lg:pt-40">
    <div class="ambient-halo"></div>
    <Container class="relative">
      <div class="mx-auto max-w-3xl text-center">
        <p data-rise style="--rise-delay:0">
          <span
            class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-line-2 bg-surface/60 px-3.5 py-1.5 text-xs font-medium text-ink-soft backdrop-blur"
          >
            <span class="inline-block size-1.5 rounded-full bg-accent pulse-dot" aria-hidden="true"></span>
            Agence d'acquisition · {site.coverage}
          </span>
        </p>

        <h1
          data-rise
          style="--rise-delay:90"
          class="mt-6 text-[2.6rem] font-semibold leading-[1.03] sm:text-6xl lg:text-7xl"
        >
          On crée votre site <span class="italic font-normal">et</span> on vous
          amène <span class="text-accent">les clients.</span>
        </h1>

        <p
          data-rise
          style="--rise-delay:180"
          class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-soft sm:mt-7 sm:text-xl"
        >
          Pour les artisans et entreprises de service premium qui veulent plus
          de clients. Un site sur-mesure qui transforme les visiteurs en
          rendez-vous — référencé sur Google, et boosté par la pub quand vous
          voulez accélérer.
        </p>

        <div
          data-rise
          style="--rise-delay:270"
          class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <Button
            href={site.contact.bookingUrl}
            variant="primary"
            size="lg"
            external
            arrow
            class="w-full sm:w-auto"
          >
            Réserver un appel de 15 min
          </Button>
          <Button
            href="/realisations"
            variant="ghost"
            size="lg"
            class="w-full sm:w-auto"
          >
            Voir nos réalisations
          </Button>
        </div>
      </div>

      <!-- Aperçu de site (preuve visuelle) -->
      <div
        data-rise
        style="--rise-delay:420"
        class="relative mx-auto mt-12 max-w-3xl sm:mt-14"
      >
        <!-- Cadre navigateur -->
        <div
          class="overflow-hidden rounded-[var(--radius-card)] border border-line-2 bg-surface shadow-[0_40px_120px_-50px_rgba(200,242,78,0.4)]"
        >
          <div
            class="flex items-center gap-2 border-b border-line bg-bg-2 px-4 py-2.5"
          >
            <span class="size-2.5 rounded-full bg-line-2" aria-hidden="true"></span>
            <span class="size-2.5 rounded-full bg-line-2" aria-hidden="true"></span>
            <span class="size-2.5 rounded-full bg-accent/70" aria-hidden="true"></span>
            <span
              class="ml-2 inline-flex items-center gap-1.5 truncate rounded-[var(--radius-pill)] border border-line bg-bg/60 px-3 py-1 text-xs text-muted"
            >
              <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.3"/>
              </svg>
              strasclean.fr
            </span>
          </div>
          <Image
            src={strascleanCover}
            alt="Aperçu du site strasclean.fr réalisé par Naviel"
            width={1100}
            height={688}
            loading="eager"
            class="w-full"
          />
        </div>

        <!-- Puces de preuve flottantes -->
        <div
          class="absolute -bottom-4 left-3 inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-accent/30 bg-bg/90 px-3.5 py-2 text-sm font-medium text-ink shadow-[0_12px_30px_-12px_rgba(0,0,0,0.85)] backdrop-blur"
        >
          <span
            class="size-2 rotate-45 rounded-[2px] bg-accent shadow-[0_0_10px_-2px_rgba(200,242,78,0.7)]"
            aria-hidden="true"></span>
          <span class="text-accent">300+</span> pages en 1ʳᵉ page Google
        </div>
        <div
          class="absolute -top-3 right-3 hidden items-center gap-2 rounded-[var(--radius-pill)] border border-line-2 bg-bg/90 px-3.5 py-2 text-sm font-medium text-ink shadow-[0_12px_30px_-12px_rgba(0,0,0,0.85)] backdrop-blur sm:inline-flex"
        >
          <span class="text-accent">★★★★★</span> Detailing premium
        </div>
      </div>
    </Container>

    <!-- Marquee mots-clés -->
    <div data-rise style="--rise-delay:450" class="mt-16 sm:mt-20">
      <Marquee items={site.keywords} />
    </div>
  </section>

  <!-- ============================ STATS ============================ -->
  <Section spacing="md">
    <StatGrid stats={site.stats} />
  </Section>

  <!-- ===================== PROBLÈME / REFRAME ===================== -->
  <Section spacing="md">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <Reveal>
        <h2 class="text-3xl font-semibold sm:text-4xl lg:text-[2.75rem]">
          Un beau site sans visiteurs, c'est une carte de visite oubliée dans un
          tiroir.
        </h2>
      </Reveal>
      <Reveal delay={100} class="space-y-5 text-base text-ink-soft sm:text-lg">
        <p>
          Le problème n'a jamais été le design. La plupart des sites
          d'artisans premium sont corrects — mais personne ne les voit. Sans
          trafic qualifié, le plus beau des sites ne génère aucun
          rendez-vous.
        </p>
        <p>
          Notre métier commence exactement là où s'arrête celui des autres :
          amener les bonnes personnes sur votre site, et les transformer en
          clients. Le design est un moyen, pas une fin.
        </p>
      </Reveal>
    </div>
  </Section>

  <!-- ===================== OFFRE / MÉTHODE ===================== -->
  <Section id="methode">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <Reveal class="max-w-2xl">
        <Kicker>Notre méthode</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">
          Trois piliers pour un site qui travaille pour vous.
        </h2>
      </Reveal>
      <Reveal delay={80}>
        <Button href="/methode" variant="ghost">
          Voir la méthode en détail
        </Button>
      </Reveal>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        piliers.map((p, i) => (
          <Reveal delay={i * 90} class="h-full">
            <MethodCard
              num={p.num}
              step={p.step}
              title={p.title}
              text={p.text}
              tag={p.tag}
              class="h-full"
            />
          </Reveal>
        ))
      }
    </div>

    <!-- Carte Google Ads — option / accélérateur, mise en valeur -->
    <Reveal delay={120} class="mt-5">
      <Card accent class="overflow-hidden">
        <div class="ambient-halo opacity-50"></div>
        <div class="relative grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
          <div>
            <span
              class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-accent/40 bg-accent/10 px-3 py-1 text-xs font-medium uppercase tracking-wider text-accent"
            >
              Option · Accélérateur
            </span>
            <h3 class="mt-4 text-2xl font-semibold sm:text-3xl">
              Google Ads : des appels qualifiés dès maintenant.
            </h3>
            <p class="mt-4 max-w-xl text-ink-soft">
              Quand vous voulez accélérer, on lance la publicité. Piloté par un
              media buyer, suivi sur le ROI, optimisé en continu. Vous payez le
              budget pub directement à Google — nous, on gère la performance.
            </p>
          </div>
          <div class="flex lg:justify-end">
            <Button href={site.contact.bookingUrl} variant="primary" external>
              En parler
            </Button>
          </div>
        </div>
      </Card>
    </Reveal>
  </Section>

  <!-- ===================== POURQUOI NOUS ===================== -->
  <Section spacing="md" class="border-y border-line bg-bg-2">
    <Reveal class="max-w-2xl">
      <Kicker>Pourquoi nous</Kicker>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">
        On ne livre pas un site. On livre des clients.
      </h2>
    </Reveal>

    <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2">
      {
        pourquoi.map((p, i) => (
          <Reveal delay={i * 80} class="bg-bg-2 p-7 sm:p-9">
            <h3 class="flex items-start gap-3 text-lg font-semibold">
              <span class="mt-1 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {p.title}
            </h3>
            <p class="mt-3 pl-[calc(0.375rem+0.75rem)] text-ink-soft">{p.text}</p>
          </Reveal>
        ))
      }
    </div>
  </Section>

  <!-- ===================== SECTEURS ===================== -->
  <Section>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <Reveal class="max-w-2xl">
        <Kicker>Secteurs</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">
          Une méthode premium, déclinée par secteur.
        </h2>
        <p class="mt-4 text-ink-soft">
          L'automobile premium est notre vitrine phare — c'est là qu'on a fait
          nos preuves. On applique la même méthode aux autres secteurs premium.
        </p>
      </Reveal>
      <Reveal delay={80}>
        <Button href="/secteurs" variant="ghost">
          Voir tous les secteurs
        </Button>
      </Reveal>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.sectors.map((sector, i) => (
          <Reveal delay={i * 70}>
            <SectorCard sector={sector} />
          </Reveal>
        ))
      }
    </div>
  </Section>

  <!-- ===================== RÉALISATIONS (teaser) ===================== -->
  <Section>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <Reveal class="max-w-2xl">
        <Kicker>Réalisations</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">
          Des sites en production, pas des maquettes.
        </h2>
        <p class="mt-4 text-ink-soft">
          Notre vitrine phare : l'automobile premium. Des sites en ligne qui
          captent la demande et la transforment en rendez-vous.
        </p>
      </Reveal>
      <Reveal delay={80}>
        <Button href="/realisations" variant="ghost">
          Toutes les réalisations
        </Button>
      </Reveal>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        teaserCases.map((cs, i) => (
          <Reveal delay={i * 90}>
            <CaseStudyCard
              href={`/realisations/${cs.slug}`}
              title={cs.data.title}
              client={cs.data.client}
              secteur={cs.data.secteur}
              summary={cs.data.summary}
              cover={cs.data.cover}
              url={cs.data.url}
              year={cs.data.year}
              clientCity={cs.data.clientCity}
              services={cs.data.services}
            />
          </Reveal>
        ))
      }
    </div>
  </Section>

  <!-- ===================== AVIS CLIENTS ===================== -->
  <Testimonials reviews={site.reviews} />

  <!-- ===================== PROCESS ===================== -->
  <Section spacing="md" class="border-y border-line bg-bg-2">
    <Reveal class="max-w-2xl">
      <Kicker>Process</Kicker>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">
        De l'appel découverte aux premiers clients.
      </h2>
    </Reveal>

    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        process.map((step, i) => (
          <Reveal as="li" delay={i * 80}>
            <Card class="h-full">
              <span class="font-display text-3xl font-semibold text-accent">
                {step.num}
              </span>
              <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{step.text}</p>
            </Card>
          </Reveal>
        ))
      }
    </ol>
  </Section>

  <!-- ===================== FAQ ===================== -->
  <Section>
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <Reveal>
        <Kicker>FAQ</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          Les questions qu'on nous pose souvent.
        </h2>
        <p class="mt-4 text-ink-soft">
          Une autre question ? Posez-la directement lors de l'appel découverte.
        </p>
      </Reveal>
      <Reveal delay={100}>
        <Faq items={faq} />
      </Reveal>
    </div>
  </Section>

  <!-- ===================== CTA FINAL ===================== -->
  <CTASection />
</Layout>
