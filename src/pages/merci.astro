---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Button from "@components/Button.astro";
import { site } from "@config";

const { adsId, adsConversionLabel } = site.analytics;
const fireConversion = Boolean(adsId && adsConversionLabel);
---

<Layout
  title="Merci"
  description="Votre demande a bien été envoyée. On vous recontacte très vite."
  noindex
>
  <section class="relative flex min-h-[70vh] items-center overflow-hidden py-28">
    <div class="ambient-halo"></div>
    <Container class="relative text-center">
      <span
        class="mx-auto mb-8 inline-flex size-16 items-center justify-center rounded-full border border-accent/40 bg-accent/10"
        aria-hidden="true"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12.5l4.5 4.5L19 7"
            stroke="#c8f24e"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>

      <h1 class="text-3xl font-semibold sm:text-5xl">Merci, c'est bien reçu.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink-soft">
        Votre demande nous est parvenue. On revient vers vous très vite — en
        général sous 24h ouvrées — pour échanger sur votre projet.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button booking variant="primary" size="lg" arrow>
          Réserver directement un créneau
        </Button>
        <Button href="/realisations" variant="ghost" size="lg">
          Voir nos réalisations
        </Button>
      </div>

      <p class="mt-8 text-sm text-muted">
        Une précision à ajouter ? Écrivez-nous à
        <a
          href={`mailto:${site.contact.email}`}
          class="text-ink-soft underline decoration-accent/40 underline-offset-4 transition-colors hover:text-ink"
          >{site.contact.email}</a
        >
      </p>
    </Container>
  </section>

  {/* Déclenchement de la conversion Google Ads (si configurée) */}
  {
    fireConversion && (
      <script is:inline define:vars={{ adsId, adsConversionLabel }}>
        {`
        if (window.gtag) {
          window.gtag('event', 'conversion', {
            send_to: adsId + '/' + adsConversionLabel,
          });
        }
        `}
      </script>
    )
  }
</Layout>
