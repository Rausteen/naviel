---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Kicker from "@components/Kicker.astro";
import Reveal from "@components/Reveal.astro";
import Card from "@components/Card.astro";
import CTASection from "@components/CTASection.astro";
import { site } from "@config";

const metiers = [
  {
    title: "Conception sur-mesure",
    text: "Un design premium orienté conversion, mobile-first, zéro template.",
  },
  {
    title: "Mise en ligne clé en main",
    text: "Domaine, hébergement, SSL, e-mails pro — vous n'avez rien à gérer.",
  },
  {
    title: "Acquisition",
    text: "SEO local pour être trouvé, et Google Ads en option pour accélérer.",
  },
];

const valeurs = [
  {
    num: "01",
    title: "Spécialistes par secteur",
    text: "On a fait nos preuves dans l'automobile premium, et on applique la même méthode aux autres secteurs. On apprend chaque marché en profondeur.",
  },
  {
    num: "02",
    title: "La performance comme preuve",
    text: "Ce site est notre vitrine. S'il est rapide, soigné et bien référencé, c'est exactement ce qu'on livre à nos clients.",
  },
  {
    num: "03",
    title: "Orientés résultats",
    text: "On ne mesure pas le succès au nombre d'animations. On le mesure au nombre de rendez-vous que votre site génère.",
  },
];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Agence",
      item: `${site.siteUrl}/agence`,
    },
  ],
};
---

<Layout
  title="Agence"
  description="Naviel, agence d'acquisition pour les artisans et commerces de service, basée à Paris. Notre approche, notre angle spécialiste par secteur, et les produits qu'on développe en interne."
  jsonLd={[breadcrumb]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <Reveal class="max-w-3xl">
      <Kicker>L'agence</Kicker>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl lg:text-6xl">
        Un studio spécialiste, pas un assembleur de templates.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft">
        {site.brandName} est née d'un constat simple : les artisans et commerces
        de service méritent mieux qu'un site générique qui ne leur amène
        personne. On a décidé de réunir le design, la technique et l'acquisition
        sous un même toit, pour une seule promesse : vous amener des clients.
      </p>

      <!-- Signaux -->
      <div class="mt-8 flex flex-wrap gap-2.5">
        {
          site.signals.map((s) => (
            <span class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-line bg-surface/60 px-3.5 py-1.5 text-sm text-ink-soft">
              <span
                class="size-1.5 rotate-45 rounded-[1px] bg-accent"
                aria-hidden="true"
              />
              {s}
            </span>
          ))
        }
      </div>
    </Reveal>
  </Section>

  <!-- Notre approche -->
  <Section spacing="sm">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <Reveal>
        <Kicker>Notre approche</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          Là où les autres s'arrêtent, on commence.
        </h2>
        <p class="mt-5 text-ink-soft">
          La plupart des agences livrent un site et disparaissent. Pour nous,
          c'est là que le vrai travail commence : un site qui ne reçoit pas de
          visiteurs qualifiés ne sert à rien. On réunit donc trois métiers sous
          un même toit — un seul interlocuteur, une seule responsabilité.
        </p>
        <p class="mt-4 text-ink-soft">
          Notre vitrine phare, c'est l'automobile premium : c'est là qu'on a
          fait nos preuves. On décline cette méthode aux autres secteurs
          — habitat, esthétique, santé, artisanat, restauration.
        </p>
      </Reveal>

      <Reveal delay={100}>
        <div class="overflow-hidden rounded-[var(--radius-card)] border border-line">
          {
            metiers.map((m, i) => (
              <div
                class:list={[
                  "flex items-start gap-4 bg-surface p-5 transition-colors hover:bg-surface-2 sm:p-6",
                  i < metiers.length - 1 && "border-b border-line",
                ]}
              >
                <span
                  class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-[10px] border border-line-2 text-accent"
                  aria-hidden="true"
                >
                  ◆
                </span>
                <div>
                  <h3 class="font-medium text-ink">{m.title}</h3>
                  <p class="mt-1 text-sm text-muted">{m.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- Valeurs -->
  <Section spacing="sm">
    <div class="grid gap-5 md:grid-cols-3">
      {
        valeurs.map((v, i) => (
          <Reveal delay={i * 90}>
            <Card hover class="h-full">
              <span class="font-display text-sm font-semibold text-accent">
                {v.num}
              </span>
              <h3 class="mt-4 text-xl font-semibold">{v.title}</h3>
              <p class="mt-3 text-ink-soft">{v.text}</p>
            </Card>
          </Reveal>
        ))
      }
    </div>
  </Section>

  {/* ===================== DERRIÈRE NAVIEL (fondateur) ===================== */}
  {
    (site.founder.name || site.founder.bio) && (
      <Section spacing="md" class="border-y border-line bg-bg-2">
        <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-14">
          {site.founder.photo && (
            <Reveal class="mx-auto lg:mx-0">
              <div class="relative">
                <div class="ambient-halo opacity-50" />
                <img
                  src={site.founder.photo}
                  alt={site.founder.name || "Fondateur de Naviel"}
                  width="240"
                  height="290"
                  loading="lazy"
                  decoding="async"
                  class="relative h-[290px] w-[240px] rounded-[var(--radius-card)] border border-line-2 object-cover"
                />
              </div>
            </Reveal>
          )}
          <Reveal delay={80}>
            <Kicker>Derrière Naviel</Kicker>
            {site.founder.name && (
              <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
                {site.founder.name}
              </h2>
            )}
            {site.founder.role && (
              <p class="mt-2 text-accent">{site.founder.role}</p>
            )}
            {site.founder.bio && (
              <p class="mt-5 max-w-2xl text-lg text-ink-soft">
                {site.founder.bio}
              </p>
            )}
            <p class="mt-5 max-w-2xl text-ink-soft">
              Un seul interlocuteur : vous parlez directement à l'expert qui
              conçoit et pilote votre acquisition. Pas d'intermédiaire, pas de
              ping-pong entre services.
            </p>
          </Reveal>
        </div>
      </Section>
    )
  }

  <!-- ===================== PRODUITS MAISON ===================== -->
  <Section spacing="md">
    <Reveal class="max-w-2xl">
      <Kicker dot={false}>Le studio</Kicker>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
        Le studio ne fait pas que des sites clients.
      </h2>
      <p class="mt-4 text-ink-soft">
        On conçoit aussi nos propres produits. C'est ce qui nous garde à la
        pointe de la technique et nourrit ce qu'on construit pour vous.
      </p>
    </Reveal>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        site.products.map((p, i) => (
          <Reveal delay={i * 80}>
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-line-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            >
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-ink">
                  <span
                    class="size-2 rotate-45 rounded-[2px] bg-accent"
                    aria-hidden="true"
                  />
                  {p.name}
                </span>
                <span
                  class="text-muted transition-transform duration-300 group-hover:translate-x-0.5 group-hover:text-ink-soft motion-reduce:transition-none"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
              {p.desc && <p class="mt-3 text-sm text-muted">{p.desc}</p>}
            </a>
          </Reveal>
        ))
      }
    </div>
  </Section>

  <CTASection />
</Layout>
