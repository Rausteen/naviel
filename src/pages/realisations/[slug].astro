---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Container from "@components/Container.astro";
import Kicker from "@components/Kicker.astro";
import Button from "@components/Button.astro";
import CTASection from "@components/CTASection.astro";
import { site } from "@config";

export async function getStaticPaths() {
  const cases = await getCollection("caseStudies");
  return cases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"caseStudies">;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

const pageUrl = `${site.siteUrl}/realisations/${entry.slug}`;

// On n'affiche que les métriques réellement renseignées (pas les placeholders)
const realMetrics = data.metrics.filter(
  (m) => m.value.trim() && m.value.trim().toUpperCase() !== "À REMPLACER",
);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Réalisations",
      item: `${site.siteUrl}/realisations`,
    },
    { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
  ],
};

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.summary,
  image: new URL(data.cover.src, site.siteUrl).href,
  datePublished: `${data.year}-01-01`,
  author: { "@type": "Organization", name: site.brandName },
  publisher: { "@type": "Organization", name: site.brandName },
  mainEntityOfPage: pageUrl,
};
---

<Layout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.summary}
  type="article"
  image={data.cover.src}
  jsonLd={[breadcrumb, articleLd]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="text-sm text-muted">
      <a href="/" class="transition-colors hover:text-ink-soft">Accueil</a>
      <span aria-hidden="true"> / </span>
      <a href="/realisations" class="transition-colors hover:text-ink-soft">
        Réalisations
      </a>
      <span aria-hidden="true"> / </span>
      <span class="text-ink-soft">{data.client}</span>
    </nav>

    <div class="mt-8 max-w-3xl">
      <Kicker>{data.secteur} · {data.year}</Kicker>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl lg:text-6xl">
        {data.title}
      </h1>
      {
        data.clientCity && (
          <p class="mt-4 inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-line px-3 py-1.5 text-sm text-ink-soft">
            <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
            Client à {data.clientCity} · accompagné à distance
          </p>
        )
      }
      <p class="mt-6 text-lg text-ink-soft">{data.summary}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href={data.url} variant="ghost" external>
          Voir le site ↗
        </Button>
        {
          data.services.map((s) => (
            <span class="rounded-[var(--radius-pill)] border border-line px-3 py-1.5 text-sm text-ink-soft">
              {s}
            </span>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Visuel de couverture -->
  <Section spacing="sm" container={false}>
    <Container>
      <div class="overflow-hidden rounded-[var(--radius-card)] border border-line">
        <Image
          src={data.cover}
          alt={`Site ${data.client} — ${data.secteur}`}
          width={1280}
          height={800}
          loading="eager"
          class="w-full object-cover"
        />
      </div>
    </Container>
  </Section>

  <!-- Métriques (affichées uniquement si de vrais chiffres sont renseignés) -->
  {
    realMetrics.length > 0 && (
      <Section spacing="sm">
        <dl class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-3">
          {realMetrics.map((m) => (
            <div class="bg-bg-2 p-6 sm:p-8">
              <dt class="font-display text-3xl font-semibold text-accent sm:text-4xl">
                {m.value}
              </dt>
              <dd class="mt-2 text-sm text-ink-soft">{m.label}</dd>
            </div>
          ))}
        </dl>
      </Section>
    )
  }

  <!-- Corps de l'étude de cas -->
  <Section spacing="sm">
    <article
      class="prose-naviel mx-auto max-w-3xl"
    >
      <Content />
    </article>
  </Section>

  <CTASection
    title={`Un projet comme ${data.client} pour vous ?`}
    text="On part de votre situation et on construit un site qui vous amène des clients. Premier échange de 15 minutes, sans engagement."
  />
</Layout>

<style is:global>
  /* Typographie de contenu (MDX) — sobre, lisible, premium */
  .prose-naviel {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-naviel > * + * {
    margin-top: 1.25rem;
  }
  .prose-naviel h2 {
    color: var(--color-ink);
    font-size: 1.6rem;
    margin-top: 2.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-naviel h3 {
    color: var(--color-ink);
    font-size: 1.25rem;
    margin-top: 2rem;
  }
  .prose-naviel a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-naviel strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-naviel ul,
  .prose-naviel ol {
    padding-left: 1.25rem;
  }
  .prose-naviel ul {
    list-style: disc;
  }
  .prose-naviel ol {
    list-style: decimal;
  }
  .prose-naviel li + li {
    margin-top: 0.5rem;
  }
  .prose-naviel li::marker {
    color: var(--color-accent);
  }
  .prose-naviel hr {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin: 2.5rem 0;
  }
  .prose-naviel blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-ink-soft);
  }
</style>
