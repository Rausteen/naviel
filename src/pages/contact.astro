---
import Layout from "@layouts/Layout.astro";
import Section from "@components/Section.astro";
import Kicker from "@components/Kicker.astro";
import Reveal from "@components/Reveal.astro";
import Button from "@components/Button.astro";
import ContactForm from "@components/ContactForm.astro";
import { site } from "@config";

// L'embed s'affiche si l'URL de réservation pointe vers une page précise
// (un chemin après le domaine), pas seulement vers la racine d'un outil.
const bookingConfigured = /^https?:\/\/[^/]+\/.+/.test(site.contact.bookingUrl);
// Si une clé Web3Forms est configurée, on privilégie le formulaire de lead.
const hasForm = Boolean(site.contact.formAccessKey);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.siteUrl },
    {
      "@type": "ListItem",
      position: 2,
      name: "Contact",
      item: `${site.siteUrl}/contact`,
    },
  ],
};
---

<Layout
  title="Contact"
  description="Contactez Naviel, agence d'acquisition basée à Paris. Réservez un appel de 15 minutes, sans engagement, ou écrivez-nous."
  jsonLd={[breadcrumb]}
>
  <Section spacing="md" class="pt-28 sm:pt-36">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <!-- Texte de réassurance -->
      <Reveal>
        <Kicker pulse>Parlons-en</Kicker>
        <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">
          Réservez un appel de 15 minutes.
        </h1>
        <p class="mt-6 text-lg text-ink-soft">
          Sans engagement. On regarde votre situation, on vous dit franchement
          ce qui peut être amélioré, et ce qu'on peut faire pour vous amener
          plus de clients.
        </p>

        <ul class="mt-8 space-y-4 text-ink-soft">
          <li class="flex items-start gap-3">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            Un échange concret, pas un argumentaire commercial.
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            Un avis honnête sur votre présence en ligne actuelle.
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            Un devis clair si on décide de travailler ensemble.
          </li>
        </ul>

        <div class="mt-10 rounded-[var(--radius-card)] border border-line bg-surface p-6">
          <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted">
            Par e-mail
          </h2>
          <a
            href={`mailto:${site.contact.email}`}
            class="mt-3 inline-block text-lg text-ink transition-colors hover:text-accent"
          >
            {site.contact.email}
          </a>
          {
            site.contact.phone && (
              <p class="mt-3">
                <a
                  href={`tel:${site.contact.phone.replace(/\s/g, "")}`}
                  class="text-lg text-ink transition-colors hover:text-accent"
                >
                  {site.contact.phone}
                </a>
              </p>
            )
          }
        </div>
      </Reveal>

      <!-- Formulaire de lead (si configuré), sinon embed de réservation Cal.com -->
      <Reveal delay={120}>
        {
          hasForm ? (
            <div>
              <ContactForm />
              <p class="mt-4 text-center text-sm text-muted">
                Vous préférez réserver directement ?{" "}
                <a
                  href={site.contact.bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent underline underline-offset-2 hover:text-accent-deep"
                >
                  Ouvrir l'agenda
                </a>
              </p>
            </div>
          ) : bookingConfigured ? (
            <div
              class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface"
            >
              <iframe
                src={site.contact.bookingUrl}
                title="Réserver un appel de découverte"
                loading="lazy"
                class="h-[680px] w-full border-0"
              />
            </div>
          ) : (
            <div class="flex h-full flex-col items-start justify-center rounded-[var(--radius-card)] border border-line bg-surface p-8">
              <p class="text-sm font-medium uppercase tracking-wider text-accent">
                Réserver un créneau
              </p>
              <h2 class="mt-3 text-2xl font-semibold text-ink">
                Choisissez l'heure qui vous arrange.
              </h2>
              <p class="mt-3 text-ink-soft">
                Cliquez ci-dessous pour ouvrir notre agenda et réserver votre
                appel de 15 minutes. Vous préférez l'e-mail ? Écrivez-nous, on
                vous répond vite.
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <Button
                  href={site.contact.bookingUrl}
                  variant="primary"
                  external
                >
                  Ouvrir l'agenda
                </Button>
                <Button href={`mailto:${site.contact.email}`} variant="ghost">
                  Écrire un e-mail
                </Button>
              </div>
            </div>
          )
        }
      </Reveal>
    </div>
  </Section>
</Layout>
