---
export interface Props {
  num: string; // ex. "01"
  step: string; // ex. "Le socle"
  title: string;
  text: string;
  tag?: string;
  ghost?: string; // chiffre fantôme (par défaut = num sans zéro)
  class?: string;
}
const {
  num,
  step,
  title,
  text,
  tag,
  ghost,
  class: className = "",
} = Astro.props;
const ghostNum = ghost ?? String(Number(num));
---

<article
  class:list={[
    "relative overflow-hidden rounded-[var(--radius-card)] border border-line bg-[linear-gradient(180deg,var(--color-surface),var(--color-bg-2))] p-7 transition-[border-color,transform] duration-300 ease-out hover:-translate-y-1 hover:border-line-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-8",
    className,
  ]}
>
  <span
    class="font-display text-sm font-semibold uppercase tracking-[0.1em] text-accent [font-variant-numeric:tabular-nums]"
  >
    {num} — {step}
  </span>
  <h3 class="mt-5 text-2xl font-semibold tracking-[-0.03em]">{title}</h3>
  <p class="mt-3 text-ink-soft">{text}</p>
  {
    tag && (
      <span class="mt-6 inline-flex rounded-[var(--radius-pill)] border border-line px-3 py-1.5 text-xs uppercase tracking-[0.1em] text-muted">
        {tag}
      </span>
    )
  }
  <!-- Chiffre fantôme géant -->
  <span
    class="pointer-events-none absolute -bottom-9 -right-2 font-display text-[9rem] font-bold leading-none tracking-[-0.05em] text-white/[0.025]"
    aria-hidden="true">{ghostNum}</span
  >
</article>
