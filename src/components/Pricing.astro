---
import Section from "./Section.astro";
import Kicker from "./Kicker.astro";
import Reveal from "./Reveal.astro";
import { site } from "@config";

export interface Props {
  /** Classes de la section (fond, bordures…) */
  class?: string;
  title?: string;
}
const {
  class: className = "border-t border-line bg-bg-2",
  title = "Transparent, sans surprise.",
} = Astro.props;

const items = site.pricing.items.filter((i) => i.from);
---

{
  site.pricing.enabled && items.length > 0 && (
    <Section id="tarifs" spacing="md" class={className}>
      <Reveal class="max-w-2xl">
        <Kicker>Tarifs</Kicker>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">
          {title}
        </h2>
        <p class="mt-4 text-ink-soft">{site.pricing.note}</p>
      </Reveal>

      <div class="mt-10 grid gap-5 sm:mt-12 md:grid-cols-3">
        {items.map((item, i) => (
          <Reveal delay={i * 80}>
            <div
              class:list={[
                "flex h-full flex-col rounded-[var(--radius-card)] border p-6 sm:p-7",
                item.badge
                  ? "border-accent/25 bg-[linear-gradient(135deg,rgba(200,242,78,0.08),rgba(200,242,78,0.02))]"
                  : "border-line bg-surface",
              ]}
            >
              <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-medium text-ink">{item.label}</p>
                {item.badge && (
                  <span class="rounded-[var(--radius-pill)] border border-accent/40 bg-accent/10 px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-accent">
                    {item.badge}
                  </span>
                )}
              </div>
              <p class="mt-4 text-sm text-muted">à partir de</p>
              <p class="mt-1 font-display text-4xl font-semibold tracking-tight text-accent">
                {item.from}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{item.note}</p>
            </div>
          </Reveal>
        ))}
      </div>

      <p class="mt-6 text-sm text-muted">
        Pas d'abonnement opaque ni de coûts cachés. Devis détaillé après l'appel
        découverte.
      </p>
    </Section>
  )
}
