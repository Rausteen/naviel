---
/**
 * Initialise Cal.com en mode embed pour TOUT le site : les boutons
 * [data-cal-link] (Button `booking`/`calLink`) ouvrent le calendrier en POPUP.
 * À la réservation, on redirige vers /merci (fenêtre principale) qui déclenche
 * la conversion Google Ads en first-party. Le script embed.js de Cal n'est
 * chargé qu'à l'init (non bloquant).
 */
---

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = /** @type {any} */ (function () { p(api, arguments); });
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); }
        else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", { origin: "https://cal.com" });
  Cal("ui", {
    theme: "dark",
    hideEventTypeDetails: false,
    cssVarsPerTheme: { dark: { "cal-brand": "#c8f24e" } },
  });
  // Réservation réussie → on renvoie vers /merci dans la fenêtre principale.
  // C'est /merci qui déclenche la conversion Google Ads (au chargement), dans
  // un contexte first-party (cookie du clic Google lisible = bonne attribution).
  // On écoute les 2 noms d'event (selon version de Cal), anti-double-comptage.
  var navielBooked = false;
  function navielOnBooking() {
    if (navielBooked) return;
    navielBooked = true;
    try { console.info("[Naviel] réservation Cal → redirection /merci"); } catch (e) {}
    window.location.href = "/merci";
  }
  Cal("on", { action: "bookingSuccessfulV2", callback: navielOnBooking });
  Cal("on", { action: "bookingSuccessful", callback: navielOnBooking });
</script>
