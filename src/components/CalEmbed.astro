---
/**
 * Initialise Cal.com en mode embed pour TOUT le site : les boutons
 * [data-cal-link] (Button `booking`/`calLink`) ouvrent le calendrier en POPUP.
 * À la réservation réussie, on déclenche la conversion Google Ads directement
 * (méthode gratuite, sans réglage côté Cal). Des logs de diagnostic listent
 * tous les événements Cal pour vérifier le déclenchement.
 */
import { site } from "@config";

const sendTo =
  site.analytics.adsId && site.analytics.adsConversionLabel
    ? `${site.analytics.adsId}/${site.analytics.adsConversionLabel}`
    : "";
---

<script is:inline define:vars={{ sendTo }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = /** @type {any} */ (function () { p(api, arguments); });
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); }
        else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  // Log IMMÉDIAT (avant tout event) : prouve que ce code est bien déployé/chargé.
  try {
    console.info(
      "%c[Naviel] CalEmbed v7 actif",
      "color:#c8f24e;font-weight:bold",
      { gtag: !!window.gtag, sendTo: sendTo || "(vide)" }
    );
  } catch (e) {}

  // ⚠️ origin DOIT être app.cal.com (page d'embed qui émet les événements).
  // Avec cal.com, le popup s'affiche mais n'émet pas bookingSuccessful.
  Cal("init", { origin: "https://app.cal.com" });
  Cal("ui", {
    theme: "dark",
    hideEventTypeDetails: false,
    cssVarsPerTheme: { dark: { "cal-brand": "#c8f24e" } },
  });

  // ── Conversion Google Ads sur réservation réussie ──────────────────────────
  var navielConverted = false;
  function navielConvert() {
    if (navielConverted) return;
    navielConverted = true;
    if (window.gtag && sendTo) {
      window.gtag("event", "conversion", { send_to: sendTo });
      try { console.info("%c[Naviel] ✅ CONVERSION ENVOYÉE", "color:#c8f24e;font-weight:bold", sendTo); } catch (e) {}
    } else {
      try { console.warn("[Naviel] réservation détectée mais gtag/send_to manquant", { gtag: !!window.gtag, sendTo: sendTo }); } catch (e) {}
    }
  }

  // ── Diagnostic : on logge les événements clés du cycle de vie de l'embed ────
  function navielLog(name) {
    return function (e) {
      try { console.info("[Naviel] event Cal:", name, (e && e.detail) || e); } catch (err) {}
    };
  }
  ["linkReady", "linkFailed", "__iframeReady", "__windowLoadComplete"].forEach(function (a) {
    Cal("on", { action: a, callback: navielLog(a) });
  });

  // Les 2 noms d'event de réservation selon la version de Cal.
  Cal("on", { action: "bookingSuccessfulV2", callback: function (e) { navielLog("bookingSuccessfulV2")(e); navielConvert(); } });
  Cal("on", { action: "bookingSuccessful", callback: function (e) { navielLog("bookingSuccessful")(e); navielConvert(); } });
</script>
