---
export interface Props {
  href?: string;
  variant?: "primary" | "ghost";
  size?: "md" | "lg";
  class?: string;
  /** Ouvre dans un nouvel onglet (liens externes) */
  external?: boolean;
  type?: "button" | "submit";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  external = false,
  type = "button",
  ariaLabel,
} = Astro.props;

const base =
  "group relative inline-flex items-center justify-center gap-2 rounded-[var(--radius-pill)] font-medium transition-all duration-300 ease-out focus-visible:outline-2 focus-visible:outline-offset-3 motion-reduce:transition-none";

const sizes = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-3.5 text-base",
}[size];

const variants = {
  primary:
    "bg-accent text-[#10110a] hover:bg-accent-deep hover:-translate-y-0.5 hover:shadow-[0_10px_40px_-12px_rgba(200,242,78,0.6)] motion-reduce:hover:translate-y-0",
  ghost:
    "border border-line-2 text-ink hover:border-line-2 hover:bg-surface hover:-translate-y-0.5 motion-reduce:hover:translate-y-0",
}[variant];

const cls = [base, sizes, variants, className];
const externalAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class:list={cls} aria-label={ariaLabel} {...externalAttrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
