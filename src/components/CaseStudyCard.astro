---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  href: string;
  title: string;
  client: string;
  secteur: string;
  summary: string;
  cover: ImageMetadata;
  url: string;
  /** Charger l'image en priorité (au-dessus de la ligne de flottaison) */
  eager?: boolean;
  class?: string;
}
const {
  href,
  title,
  client,
  secteur,
  summary,
  cover,
  url,
  eager = false,
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface transition-all duration-300 ease-out hover:-translate-y-1 hover:border-line-2 hover:shadow-[0_24px_60px_-30px_rgba(0,0,0,0.8)] motion-reduce:transition-none motion-reduce:hover:translate-y-0",
    className,
  ]}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-bg-2">
    <Image
      src={cover}
      alt={`Aperçu du site ${client} — ${secteur}`}
      width={800}
      height={500}
      loading={eager ? "eager" : "lazy"}
      class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
    <span
      class="absolute left-4 top-4 rounded-[var(--radius-pill)] border border-line-2 bg-bg/70 px-3 py-1 text-xs font-medium uppercase tracking-wider text-ink-soft backdrop-blur"
    >
      {secteur}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-muted">
      <span>{client}</span>
      <span aria-hidden="true">·</span>
      <span class="truncate">{url.replace(/^https?:\/\//, "")}</span>
    </div>
    <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{summary}</p>
    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent"
    >
      Voir l'étude de cas
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
        aria-hidden="true"
      >
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>
