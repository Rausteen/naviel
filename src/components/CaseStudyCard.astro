---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  href: string;
  title: string;
  client: string;
  secteur: string;
  summary: string;
  cover: ImageMetadata;
  url: string;
  year?: number;
  clientCity?: string;
  services?: string[];
  /** Charger l'image en priorité (au-dessus de la ligne de flottaison) */
  eager?: boolean;
  class?: string;
}
const {
  href,
  title,
  client,
  secteur,
  summary,
  cover,
  year,
  clientCity,
  services = [],
  eager = false,
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface transition-[border-color,transform] duration-300 ease-out hover:-translate-y-1 hover:border-line-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0",
    className,
  ]}
>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-bg-2">
    <Image
      src={cover}
      alt={`Aperçu du site ${client} — ${secteur}`}
      width={800}
      height={500}
      loading={eager ? "eager" : "lazy"}
      class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
    {
      year && (
        <span class="absolute right-4 top-4 rounded-[var(--radius-pill)] border border-line bg-bg/60 px-2.5 py-1 font-display text-sm text-ink-soft backdrop-blur">
          {year}
        </span>
      )
    }
    {
      clientCity && (
        <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-line bg-bg/60 px-2.5 py-1 text-xs text-ink-soft backdrop-blur">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
          Client à {clientCity}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-7">
    <span
      class="text-xs font-semibold uppercase tracking-[0.1em] text-accent-deep"
    >
      {secteur}
    </span>
    <h3 class="mt-3 text-[1.55rem] font-semibold tracking-[-0.03em] text-ink">
      {title}
    </h3>
    <p class="mt-2 text-[0.98rem] leading-relaxed text-ink-soft">{summary}</p>

    {
      services.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {services.map((s) => (
            <span class="rounded-[var(--radius-pill)] border border-line px-3 py-1 text-xs text-ink-soft">
              {s}
            </span>
          ))}
        </div>
      )
    }

    <span
      class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-ink"
    >
      Lire l'étude de cas
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        class="text-accent transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
        aria-hidden="true"
      >
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>
