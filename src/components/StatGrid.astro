---
import Reveal from "./Reveal.astro";
import type { Stat } from "@config";

export interface Props {
  stats: readonly Stat[];
  class?: string;
}
const { stats, class: className = "" } = Astro.props;

// Sépare la valeur en préfixe / cœur numérique / suffixe pour mettre les
// symboles (×, +, h, Top…) en accent, le nombre en ink — comme la maquette.
function splitValue(value: string): { prefix: string; core: string; suffix: string } {
  const match = value.match(/^(\D*)([\d.,\s]+)(.*)$/u);
  if (!match) return { prefix: "", core: value, suffix: "" };
  return { prefix: match[1] ?? "", core: match[2] ?? "", suffix: match[3] ?? "" };
}
---

<Reveal>
  <dl
    class:list={[
      "grid grid-cols-2 overflow-hidden rounded-[var(--radius-card)] border border-line bg-[linear-gradient(180deg,var(--color-surface),var(--color-bg-2))] lg:grid-cols-4",
      className,
    ]}
  >
    {
      stats.map((stat, i) => {
        const { prefix, core, suffix } = splitValue(stat.value);
        return (
          <div
            class:list={[
              "border-line p-7 sm:p-8",
              i % 2 === 0 && "border-r lg:border-r",
              i < stats.length - 1 && "lg:border-r",
              i < 2 && "border-b lg:border-b-0",
            ]}
          >
            <dt class="font-display text-[clamp(2.1rem,3.4vw,2.9rem)] font-semibold leading-none tracking-[-0.04em] text-ink">
              {prefix && <em class="not-italic text-accent">{prefix}</em>}
              {core}
              {suffix && <em class="not-italic text-accent">{suffix}</em>}
            </dt>
            <dd class="mt-2.5 text-sm leading-snug text-muted">{stat.label}</dd>
          </div>
        );
      })
    }
  </dl>
</Reveal>
