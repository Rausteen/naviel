---
import { site } from "@config";

const { phone, whatsapp, bookingUrl } = site.contact;
const telHref = phone ? `tel:${phone.replace(/[^+\d]/g, "")}` : null;
const waHref = whatsapp
  ? `https://wa.me/${whatsapp.replace(/[^\d]/g, "")}?text=${encodeURIComponent(
      "Bonjour, je souhaite des informations sur la création de mon site.",
    )}`
  : null;
---

<!-- Barre CTA persistante (mobile uniquement) -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-bg/90 backdrop-blur-xl md:hidden"
  style="padding-bottom:env(safe-area-inset-bottom)"
>
  <div class="flex items-stretch gap-2 px-3 py-2.5">
    <a
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-1 items-center justify-center gap-2 rounded-[var(--radius-pill)] bg-accent px-4 py-3 text-sm font-semibold text-[#10110a]"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="2" y="3" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/>
        <path d="M2 6h12M5 1.5v3M11 1.5v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      Réserver un appel
    </a>

    {
      telHref && (
        <a
          href={telHref}
          class="flex items-center justify-center rounded-[var(--radius-pill)] border border-line-2 px-4 py-3 text-ink"
          aria-label="Appeler"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.5 5.5c0 7.18 5.82 13 13 13 .67 0 1.32-.05 1.95-.15a1 1 0 0 0 .85-.99v-2.7a1 1 0 0 0-.84-.99l-2.5-.42a1 1 0 0 0-.98.42l-.7 1a11.3 11.3 0 0 1-4.6-4.6l1-.7a1 1 0 0 0 .42-.98l-.42-2.5a1 1 0 0 0-.99-.84H6.49a1 1 0 0 0-.99.85c-.1.63-.15 1.28-.15 1.95Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </a>
      )
    }

    {
      waHref && (
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center rounded-[var(--radius-pill)] border border-line-2 px-4 py-3 text-ink"
          aria-label="WhatsApp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.33 4.95L2 22l5.2-1.36a9.93 9.93 0 0 0 4.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm5.8 14.16c-.24.68-1.4 1.3-1.94 1.34-.5.04-.97.22-3.27-.68-2.76-1.08-4.5-3.9-4.64-4.08-.14-.18-1.1-1.46-1.1-2.78 0-1.32.7-1.97.94-2.24.24-.27.52-.34.7-.34h.5c.16 0 .38-.06.6.46.22.54.76 1.86.83 2 .07.13.11.29.02.47-.09.18-.14.29-.27.45-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.27.14.43.11.59-.07.16-.18.68-.79.86-1.06.18-.27.36-.22.6-.13.25.09 1.57.74 1.84.88.27.13.45.2.52.31.07.11.07.64-.17 1.32Z"/>
          </svg>
        </a>
      )
    }
  </div>
</div>

<!-- Espace pour ne pas masquer le bas de page sous la barre -->
<div class="h-[68px] md:hidden" aria-hidden="true"></div>
