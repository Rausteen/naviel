---
import type { Sector } from "@config";

export interface Props {
  sector: Sector;
  class?: string;
}
const { sector, class: className = "" } = Astro.props;
const { name, slug, featured, desc } = sector;
---

<a
  href={`/secteurs/${slug}`}
  class:list={[
    "group relative flex h-full flex-col justify-between overflow-hidden rounded-[var(--radius-card)] border p-4 transition-all duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-6",
    featured
      ? "border-accent/30 bg-[linear-gradient(135deg,rgba(200,242,78,0.10),rgba(200,242,78,0.02))] hover:border-accent/50"
      : "border-line bg-surface hover:border-line-2",
    className,
  ]}
>
  {featured && <div class="ambient-halo opacity-40"></div>}
  <div class="relative">
    <span
      class:list={[
        "inline-flex items-center gap-2 rounded-[var(--radius-pill)] border px-2.5 py-1 text-[0.6rem] font-medium uppercase tracking-wider sm:px-3 sm:text-xs",
        featured
          ? "border-accent/40 bg-accent/10 text-accent"
          : "border-line text-muted",
      ]}
    >
      {featured ? "Vitrine phare" : "Secteur accompagné"}
    </span>
    <h3 class="mt-3 text-base font-semibold tracking-tight text-ink sm:mt-4 sm:text-xl">
      {name}
    </h3>
    {desc && <p class="mt-2 text-xs text-ink-soft sm:text-sm">{desc}</p>}
  </div>

  <span
    class="relative mt-4 inline-flex items-center gap-1.5 text-[0.8rem] font-medium text-accent sm:mt-6 sm:text-sm"
  >
    {featured ? "Découvrir" : "En savoir plus"}
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
      aria-hidden="true"
    >
      <path
        d="M3 8h10M9 4l4 4-4 4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
