---
export interface Props {
  items: readonly string[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;
// Dédoublé pour une boucle continue (translateX -50%)
const loop = [...items, ...items];
---

<div
  class:list={[
    "group relative flex overflow-hidden border-y border-line bg-bg-2 py-5",
    className,
  ]}
  aria-hidden="true"
>
  <!-- masques de bord -->
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-bg-2 to-transparent"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-bg-2 to-transparent"
  >
  </div>

  <ul class="marquee-track flex shrink-0 items-center gap-10 pr-10">
    {
      loop.map((item) => (
        <li class="flex items-center gap-10 whitespace-nowrap font-display text-lg font-medium tracking-tight text-ink-soft sm:text-xl">
          <span>{item}</span>
          <span class="size-1.5 rounded-full bg-accent/70" />
        </li>
      ))
    }
  </ul>
</div>
