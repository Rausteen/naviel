---
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import { site } from "@config";

const year = new Date().getFullYear();
const calLink = site.contact.bookingUrl.replace(/^https?:\/\/(app\.)?cal\.com\//, "");

const services = [
  { label: "Création de site", href: "/creation-site" },
  { label: "Refonte de site", href: "/refonte-site-internet" },
  { label: "SEO local", href: "/seo-local" },
  { label: "Google Ads", href: "/google-ads" },
];
const explorer = [
  { label: "Réalisations", href: "/realisations" },
  { label: "Secteurs", href: "/secteurs" },
  { label: "Offre & tarifs", href: "/offre" },
  { label: "Agence", href: "/agence" },
  { label: "Blog", href: "/blog" },
];
---

<footer class="relative border-t border-line bg-bg-2">
  <Container class="py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <!-- Marque -->
      <div class="sm:col-span-2 lg:col-span-1">
        <Logo class="text-[1.3rem]" />
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
          {site.tagline}
        </p>
        <p class="mt-2 text-sm text-muted">
          Artisans & commerces de service · {site.city}
        </p>
      </div>

      <!-- Services -->
      <nav aria-label="Services">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">
          Services
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((item) => (
              <li>
                <a href={item.href} class="text-ink-soft transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Explorer -->
      <nav aria-label="Plan du site">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">
          Explorer
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            explorer.map((item) => (
              <li>
                <a href={item.href} class="text-ink-soft transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <nav aria-label="Contact">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">
          Contact
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a
              href={`mailto:${site.contact.email}`}
              class="text-ink-soft transition-colors hover:text-ink"
            >
              {site.contact.email}
            </a>
          </li>
          {
            site.contact.phone && (
              <li>
                <a
                  href={`tel:${site.contact.phone.replace(/\s/g, "")}`}
                  class="text-ink-soft transition-colors hover:text-ink"
                >
                  {site.contact.phone}
                </a>
              </li>
            )
          }
          <li>
            <button
              type="button"
              data-cal-link={calLink}
              data-cal-config='{"layout":"month_view","theme":"dark"}'
              class="text-left text-accent transition-colors hover:text-accent-deep"
            >
              Réserver un appel
            </button>
          </li>
          <li>
            <a
              href="/creation-site-internet-paris"
              class="text-ink-soft transition-colors hover:text-ink"
            >
              {site.city}, France
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.brandName}. Tous droits réservés.</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/mentions-legales" class="transition-colors hover:text-ink-soft">
          Mentions légales
        </a>
        <a href="/confidentialite" class="transition-colors hover:text-ink-soft">
          Confidentialité
        </a>
        <span class="inline-flex items-center gap-2">
          <span
            class="inline-block size-[9px] rotate-45 rounded-[2px] bg-accent shadow-[0_0_12px_-2px_rgba(200,242,78,0.7)]"
            aria-hidden="true"></span>
          Conçu &amp; développé à {site.city}
        </span>
      </div>
    </div>
  </Container>
</footer>
